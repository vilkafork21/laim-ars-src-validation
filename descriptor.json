{
  "id": "cc825a56-edbd-4bf2-bc78-a895326de5f4",
  "name": "laim-ars-src-validation",
  "description": "Версионированная кодовая база проверки качества телеметрии для SberDS и DataLab",
  "fullDescription": "Нода без входов и настроек. Детерминированно упаковывает единое ядро validation, которое строит актуальный отчёт K1–K7 и диагностический раздел K8. Выходы codebase_validation и checksum_validation используются совместно нодами laim-ars-env-validation-uf и laim-mart-report-batch. Одинаковая кодовая база всегда имеет одинаковый SHA-256; checksum является идентификатором фактически исполненной версии расчёта.",
  "shortNameToDisplay": "VSRC",
  "ports": [
    {
      "in": false,
      "name": "codebase_validation",
      "label": "codebase_validation",
      "description": "Детерминированный tar.gz ядра validation, закодированный в base64",
      "type": "default",
      "shape": "shape_model",
      "order": 1
    },
    {
      "in": false,
      "name": "checksum_validation",
      "label": "checksum_validation",
      "description": "SHA-256 архива codebase_validation",
      "type": "default",
      "shape": "shape_model",
      "order": 2
    }
  ],
  "script": {
    "type": "python",
    "deployType": "docker",
    "baseImageKey": "py312-simple",
    "runConfiguration": {
